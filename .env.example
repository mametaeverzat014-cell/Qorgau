# ---------------------------------------------------------------------------
# AdmitPath AI — environment variables
#
# The product is fully functional WITHOUT any of these values.
# The recommendation engine, diagnostics, comparison, roadmap, next-action and
# progress tracking are 100% deterministic and run locally in the browser.
#
# The optional AI layer only rewrites explanation copy in more natural language.
# If the key is absent or the API call fails, the app silently falls back to the
# deterministic explanations produced by the engine.
# ---------------------------------------------------------------------------

# Optional. Server-side only — never exposed to the browser.
# Used by the route handler at src/app/api/explain/route.ts
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 when unset.
ANTHROPIC_MODEL=claude-sonnet-5
