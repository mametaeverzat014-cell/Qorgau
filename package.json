{
  "name": "admitpath-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AdmitPath AI \u2014 personalized university admissions navigator (LOCUSCASE2)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "check:links": "node scripts/check-links.mjs",
    "data:init": "node scripts/university-data/cli.mjs init-registry",
    "data:discover": "node scripts/university-data/cli.mjs discover",
    "data:ingest": "node scripts/university-data/cli.mjs ingest",
    "data:review": "node scripts/university-data/cli.mjs review",
    "data:approve": "node scripts/university-data/cli.mjs approve",
    "data:diff": "node scripts/university-data/cli.mjs diff",
    "data:check-freshness": "node scripts/university-data/cli.mjs check-freshness",
    "data:coverage": "node scripts/university-data/cli.mjs coverage",
    "data:status": "node scripts/university-data/cli.mjs status"
  },
  "dependencies": {
    "lucide-react": "0.544.0",
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "playwright": "^1.55.0",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
